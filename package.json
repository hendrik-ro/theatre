{
  "name": "theatre",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:generate": "npm run generate --workspace server",
    "dev:migrate": "npm run migrate --workspace server",
    "test": "npm run test --workspace server",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  }
}
