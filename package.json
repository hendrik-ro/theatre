{
  "name": "theatre",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:generate": "npm run generate --workspace server",
    "dev:migrate": "npm run migrate --workspace server",
    "test": "npm run test --workspace server",
    "lint": "oxlint .",
    "ci": "commitlint --from origin/main --to HEAD && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
